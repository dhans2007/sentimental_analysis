# Copy this file to .env and fill in your own values for local development.
# For Cloud Foundry, MONGO_URI is instead injected via the bound Mongo service
# (see manifest.yml / VCAP_SERVICES) rather than an .env file.

MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/sentiment_db
PORT=5000

# Optional: Google Gemini API Key for dynamic AI Auto-Replies (from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
